{
  "name": "digital-romania-atlas",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/validate-data.mjs && node --test tests/preview-gate.test.mjs",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm test && npm run typecheck && npm run build && npm run test:e2e",
    "lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "d3": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
